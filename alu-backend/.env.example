# ===========================================
# ALU BACKEND - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)

# ===========================================
# DATABASE
# ===========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/alu?retryWrites=true&w=majority

# ===========================================
# AUTHENTICATION (Clerk)
# ===========================================
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# ===========================================
# AI SERVICES
# ===========================================
# Google Gemini (for NanoBanana image gen + prompt cleaning)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxx

# Third-party video API (Sora, etc.) - optional for v1
THIRD_PARTY_API_URL=https://api.example.com/generate
THIRD_PARTY_API_KEY=xxxxxxxxxxxxx

# ===========================================
# PAYMENTS (Stripe)
# ===========================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ===========================================
# ANALYTICS (PostHog)
# ===========================================
POSTHOG_API_KEY=phc_xxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# ===========================================
# APP CONFIG
# ===========================================
PORT=5000
FRONTEND_URL=https://your-frontend.vercel.app
NODE_ENV=development
